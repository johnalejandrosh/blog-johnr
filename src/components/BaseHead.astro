---
// Se importa global.css aquí para que llegue a todas las páginas a través de
// <BaseHead />.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { AUTHOR, SITE_TITLE } from '../consts';
import { Font } from 'astro:assets';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
	/** Marca la página como artículo en Open Graph y añade JSON-LD. */
	article?: {
		publishedTime: Date;
		modifiedTime?: Date;
		section?: string;
		tags?: string[];
	};
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const { title, description, image, article } = Astro.props;
const ogImage = image ? new URL(image.src, Astro.url) : undefined;

const jsonLd = article
	? {
			'@context': 'https://schema.org',
			'@type': 'BlogPosting',
			headline: title,
			description,
			datePublished: article.publishedTime.toISOString(),
			...(article.modifiedTime && { dateModified: article.modifiedTime.toISOString() }),
			author: { '@type': 'Person', name: AUTHOR.name },
			mainEntityOfPage: canonicalURL.href,
			...(article.section && { articleSection: article.section }),
			...(article.tags?.length && { keywords: article.tags.join(', ') }),
			inLanguage: 'es-CO',
		}
	: null;
---

<!-- Metadatos globales -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />

<!-- Tema: se resuelve aquí, en línea y antes de la hoja de estilos, para que la
     primera pintura ya sea la definitiva. Manda la elección guardada; si no
     hay, manda el sistema. Sin JavaScript decide la media query de global.css. -->
<script is:inline>
	try {
		const stored = localStorage.getItem('tema');
		document.documentElement.dataset.theme =
			stored === 'light' || stored === 'dark'
				? stored
				: window.matchMedia('(prefers-color-scheme: dark)').matches
					? 'dark'
					: 'light';
	} catch (error) {
		document.documentElement.dataset.theme = window.matchMedia('(prefers-color-scheme: dark)')
			.matches
			? 'dark'
			: 'light';
	}
</script>
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />
<meta name="author" content={AUTHOR.name} />
<!-- Lo ajusta ThemeToggle según el tema activo -->
<meta name="theme-color" content="#f4f1e9" />

<Font cssVariable="--font-mono" preload />
<Font cssVariable="--font-serif" />

<!-- URL canónica -->
<link rel="canonical" href={canonicalURL} />

<!-- Metadatos principales -->
<title>{title}</title>
<meta name="description" content={description} />

<!-- Open Graph -->
<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:locale" content="es_CO" />
<meta property="og:site_name" content={SITE_TITLE} />
{ogImage && <meta property="og:image" content={ogImage} />}
{
	article && (
		<>
			<meta property="article:published_time" content={article.publishedTime.toISOString()} />
			{article.modifiedTime && (
				<meta property="article:modified_time" content={article.modifiedTime.toISOString()} />
			)}
			<meta property="article:author" content={AUTHOR.name} />
			{article.section && <meta property="article:section" content={article.section} />}
			{article.tags?.map((tag) => <meta property="article:tag" content={tag} />)}
		</>
	)
}

<!-- Twitter -->
<meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />

{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
