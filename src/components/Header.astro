---
import { AUTHOR } from '../consts';
import HeaderLink from './HeaderLink.astro';
import ThemeToggle from './ThemeToggle.astro';
---

<header class="site-header">
	<div class="container site-header__inner">
		<a class="brand" href="/" aria-label="johnr.log, ir al inicio">
			<span class="brand__path">~/</span>{AUTHOR.handle}<span class="brand__ext">.log</span>
			<span class="brand__cursor" aria-hidden="true"></span>
		</a>

		<nav class="site-nav" aria-label="Principal">
			<HeaderLink href="/blog">blog</HeaderLink>
			<HeaderLink href="/categoria">temas</HeaderLink>
			<HeaderLink href="/portafolio">portafolio</HeaderLink>
			<HeaderLink href="/lab" class="site-nav__link--lab" title="Un Linux de verdad en tu navegador">
				lab<span class="live-dot" aria-hidden="true"></span>
			</HeaderLink>
		</nav>

		<ThemeToggle />
	</div>
</header>
