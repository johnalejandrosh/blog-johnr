---
import BaseLayout from '../layouts/BaseLayout.astro';
import LabTeaser from '../components/LabTeaser.astro';
import { AUTHOR, SITE_TITLE } from '../consts';
---

<BaseLayout title={`404 · ${SITE_TITLE}`} description="Esta página no existe.">
	<div class="container">
		<section class="section section--last">
			<div class="terminal notfound__window">
				<div class="terminal__bar">
					<span class="terminal__lights" aria-hidden="true">
						<span class="terminal__light terminal__light--close">×</span>
						<span class="terminal__light terminal__light--min">−</span>
						<span class="terminal__light terminal__light--max">+</span>
					</span>
					<span class="terminal__title">{AUTHOR.handle} — -zsh — 80×24</span>
				</div>
				<div class="terminal__body">
					<p class="terminal__line">
						<span class="terminal__prompt">
							<span class="terminal__user">{AUTHOR.handle}@macbook</span>
							<span class="terminal__path">~</span>
							<span class="terminal__sign">%</span>
						</span>
						<span>cd {Astro.url.pathname}</span>
					</p>
					<p class="terminal__out">cd: no such file or directory: {Astro.url.pathname}</p>
					<p class="terminal__line">
						<span class="terminal__prompt">
							<span class="terminal__user">{AUTHOR.handle}@macbook</span>
							<span class="terminal__path">~</span>
							<span class="terminal__sign">%</span>
						</span>
						<span class="terminal__cursor" aria-hidden="true"></span>
					</p>
				</div>
			</div>
			<div class="notfound">
				<h1 class="page-hero__title">404: aquí no hay nada</h1>
				<p class="page-hero__text">
					Puede que el enlace esté viejo o que la entrada haya cambiado de dirección.
				</p>
				<div class="cluster">
					<a class="button button--primary" href="/">ir al inicio</a>
					<a class="button" href="/blog">ver el blog</a>
				</div>
			</div>

			<div class="section">
				<LabTeaser />
			</div>
		</section>
	</div>
</BaseLayout>
