---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CategoryFilters from '../../components/CategoryFilters.astro';
import PostCard from '../../components/PostCard.astro';
import { CATEGORIES, SITE_TITLE } from '../../consts';
import { byCategory, getPosts } from '../../lib/posts';

const posts = await getPosts();
const counts = Object.fromEntries(CATEGORIES.map((c) => [c.slug, byCategory(posts, c.slug).length]));
---

<BaseLayout
	title={`Blog · ${SITE_TITLE}`}
	description="Todas las entradas del blog: bases de datos, backend, arquitectura, cloud, inteligencia artificial y astronomía."
>
	<PageHero command="ls -lt" path="blog">
		<h1 class="page-hero__title">Blog</h1>
		<p class="page-hero__text">
			Todo lo que he publicado, de lo más reciente a lo más viejo. Si buscas algo puntual, filtra
			por tema.
		</p>
	</PageHero>

	<div class="container">
		<section class="section--tight" aria-label="Temas">
			<CategoryFilters active={null} counts={counts} total={posts.length} allHref="/blog" />
		</section>

		<section class="section--tight section--last">
			<div class="grid-cards">
				{posts.map((post) => <PostCard post={post} />)}
			</div>
		</section>
	</div>
</BaseLayout>
