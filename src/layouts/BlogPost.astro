---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Newsletter from '../components/Newsletter.astro';
import PostCard from '../components/PostCard.astro';
import PostCover from '../components/PostCover.astro';
import PostRow from '../components/PostRow.astro';
import ShareButton from '../components/ShareButton.astro';
import { AUTHOR, SITE_TITLE } from '../consts';
import { categoryName, categoryUrl, isoDate, readingTime, type Post } from '../lib/posts';

interface Props {
	post: Post;
	/** Se muestran en "Sigue leyendo". */
	related?: Post[];
	/** Lista del rail derecho. */
	popular?: Post[];
}

const { post, related = [], popular = [] } = Astro.props;
const { title, description, pubDate, updatedDate, heroImage, heroImageAlt, heroImageCredit, category, tags } =
	post.data;
const minutes = readingTime(post.body);
---

<!doctype html>
<html lang="es-CO">
	<head>
		<BaseHead
			title={`${title} · ${SITE_TITLE}`}
			description={description}
			image={heroImage}
			article={{
				publishedTime: pubDate,
				modifiedTime: updatedDate,
				section: categoryName(category),
				tags,
			}}
		/>
	</head>

	<body>
		<a class="skip-link" href="#main">Saltar al contenido</a>
		<Header />

		<!-- Mide el avance dentro del ARTÍCULO, no de la página. -->
		<div class="reading-progress" data-reading-progress></div>

		<main id="main" tabindex="-1">
			<div class="container">
				<div class="shell shell--article">
					<!-- Índice -->
					<aside class="rail rail--toc" aria-label="Índice del artículo">
						<div>
							<span class="eyebrow">índice</span>
							<!-- Vacío a propósito: el script de abajo lo genera desde los h2. -->
							<nav class="toc" data-toc></nav>
						</div>
						<div>
							<span class="eyebrow">compartir</span>
							<ShareButton title={title} />
						</div>
					</aside>

					<!-- Artículo -->
					<article id="articulo">
						<header class="article-header">
							<nav class="breadcrumb" aria-label="Ruta">
								<a href="/">~</a>/<a href="/blog">blog</a>/<a href={categoryUrl(category)}>{category}</a
								>/<span aria-current="page">{post.id}.md</span>
							</nav>

							<h1 class="article-title">{title}</h1>
							<p class="article-lede">{description}</p>

							<!-- El frontmatter, a la vista. -->
							<dl class="frontmatter">
								<div><dt>autor</dt><dd>{AUTHOR.name}</dd></div>
								<div>
									<dt>publicado</dt>
									<dd><time datetime={pubDate.toISOString()}>{isoDate(pubDate)}</time></dd>
								</div>
								{
									updatedDate && (
										<div>
											<dt>actualizado</dt>
											<dd>
												<time datetime={updatedDate.toISOString()}>{isoDate(updatedDate)}</time>
											</dd>
										</div>
									)
								}
								<div>
									<dt>tema</dt>
									<dd><a href={categoryUrl(category)}>{categoryName(category)}</a></dd>
								</div>
								<div><dt>lectura</dt><dd>{minutes} min</dd></div>
								{
									tags.length > 0 && (
										<div>
											<dt>tags</dt>
											<dd>[{tags.join(', ')}]</dd>
										</div>
									)
								}
							</dl>
						</header>

						<figure class="article-cover">
							{
								heroImage ? (
									<>
										<Image
											src={heroImage}
											alt={heroImageAlt ?? ''}
											width={1280}
											height={720}
											loading="eager"
											fetchpriority="high"
										/>
										{heroImageCredit && <figcaption>Foto: {heroImageCredit}</figcaption>}
									</>
								) : (
									<PostCover slug={post.id} label={categoryName(category)} wide />
								)
							}
						</figure>

						<!-- El cuerpo entero va dentro de .prose: el HTML de dentro no
						     necesita ni una clase, que es justo lo que sale de Markdown. -->
						<div class="prose">
							<slot />
						</div>

						<p class="eof" aria-hidden="true">-- EOF --</p>

						<div class="section--tight">
							<Newsletter id="newsletter" title="¿Te sirvió? Te aviso de la siguiente" />
						</div>

						{
							related.length > 0 && (
								<section class="section">
									<div class="section-title">
										<h2>sigue leyendo</h2>
									</div>
									<div class="grid-cards grid-cards--two">
										{related.map((item) => (
											<PostCard post={item} />
										))}
									</div>
								</section>
							)
						}
					</article>

					<!-- Rail secundario -->
					<aside class="rail rail--secondary" aria-label="Sobre el autor">
						<div class="card card--pad">
							<span class="eyebrow">quién escribe</span>
							<div class="author">
								<span class="avatar" aria-hidden="true">{AUTHOR.initials}</span>
								<div>
									<div class="author__name">{AUTHOR.name}</div>
									<div class="author__role">{AUTHOR.role}</div>
								</div>
							</div>
							<p class="card__text">{AUTHOR.bio}</p>
							<a class="text-link" href="/portafolio">ver portafolio →</a>
						</div>

						{
							popular.length > 0 && (
								<div class="card">
									<span class="eyebrow card__eyebrow">más entradas</span>
									<div class="ls ls--compact">
										{popular.map((item) => (
											<PostRow post={item} />
										))}
									</div>
								</div>
							)
						}
					</aside>
				</div>
			</div>
		</main>

		<Footer />

		<script>
			// --- Barra de progreso del artículo -------------------------------------
			const bar = document.querySelector<HTMLElement>('[data-reading-progress]');
			const article = document.querySelector<HTMLElement>('#articulo');

			if (bar && article) {
				bar.setAttribute('role', 'progressbar');
				bar.setAttribute('aria-label', 'Progreso de lectura');
				bar.setAttribute('aria-valuemin', '0');
				bar.setAttribute('aria-valuemax', '100');

				let frame = 0;
				const update = () => {
					frame = 0;
					const box = article.getBoundingClientRect();
					const total = box.height - window.innerHeight;
					const ratio = total > 0 ? Math.min(Math.max(-box.top / total, 0), 1) : 0;
					bar.style.setProperty('--progress', ratio.toFixed(4));
					bar.setAttribute('aria-valuenow', String(Math.round(ratio * 100)));
				};

				// El scroll dispara muy seguido: el trabajo real se hace en un frame.
				const onScroll = () => {
					if (!frame) frame = requestAnimationFrame(update);
				};

				window.addEventListener('scroll', onScroll, { passive: true });
				window.addEventListener('resize', onScroll, { passive: true });
				update();
			}

			// --- Índice con scroll-spy ----------------------------------------------
			const nav = document.querySelector<HTMLElement>('[data-toc]');
			const headings = article
				? [...article.querySelectorAll<HTMLHeadingElement>('.prose h2')].filter((h) => h.id)
				: [];

			if (nav && headings.length) {
				// El cuerpo viene de Markdown y no trae índice: se genera desde los h2.
				nav.innerHTML = headings
					.map((h) => `<a class="toc__link" href="#${h.id}">${h.textContent?.trim() ?? ''}</a>`)
					.join('');

				const links = new Map(
					[...nav.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')].map((a) => [
						decodeURIComponent(a.getAttribute('href')!.slice(1)),
						a,
					]),
				);

				let activeId = '';
				const setActive = (id: string) => {
					if (id === activeId) return;
					activeId = id;
					links.forEach((link, key) => {
						const on = key === id;
						link.classList.toggle('is-active', on);
						if (on) link.setAttribute('aria-current', 'true');
						else link.removeAttribute('aria-current');
					});
				};

				// La banda superior de la ventana decide la sección activa: el titular
				// que acabas de pasar es el que estás leyendo.
				const visible = new Map<string, boolean>();
				const observer = new IntersectionObserver(
					(entries) => {
						entries.forEach((entry) => visible.set(entry.target.id, entry.isIntersecting));
						const current = headings.find((h) => visible.get(h.id));
						if (current) setActive(current.id);
					},
					{ rootMargin: '-80px 0px -70% 0px', threshold: 0 },
				);

				headings.forEach((h) => observer.observe(h));

				// Al final del documento gana la última sección: puede que nunca cruce
				// la banda si es más corta que la ventana.
				window.addEventListener(
					'scroll',
					() => {
						const atBottom =
							window.innerHeight + window.scrollY >= document.body.scrollHeight - 2;
						if (atBottom) setActive(headings[headings.length - 1].id);
					},
					{ passive: true },
				);
			}

			// --- Etiqueta de lenguaje y botón de copiar en los bloques de código ------
			document.querySelectorAll<HTMLPreElement>('.prose pre').forEach((pre) => {
				const wrap = document.createElement('div');
				wrap.className = 'code-block';
				pre.replaceWith(wrap);
				wrap.append(pre);

				const lang = pre.dataset.language;
				const head = document.createElement('div');
				head.className = 'code-block__bar';
				head.innerHTML = `<span>${lang && lang !== 'plaintext' ? lang : 'texto'}</span>`;

				const copy = document.createElement('button');
				copy.type = 'button';
				copy.className = 'code-block__copy';
				copy.textContent = 'copiar';
				copy.addEventListener('click', async () => {
					try {
						await navigator.clipboard.writeText(pre.innerText);
						copy.textContent = 'copiado';
					} catch {
						copy.textContent = 'no se pudo';
					}
					setTimeout(() => (copy.textContent = 'copiar'), 1800);
				});

				head.append(copy);
				wrap.prepend(head);
			});
		</script>
	</body>
</html>
